{
  "expo": {
    "name": "GasAround",
    "slug": "GasAround",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gasaround",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A2A53",
        "foregroundImage": "./assets/images/android-icon-foreground.jpeg",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCxJS7O0KTa8EPKImLjoJ1cLfozf2MvjKQ"
        }
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lamech_kosgei.GasAround",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "gasaround"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.jpeg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#1A2A53",
            "image": "./assets/images/splash-icon.jpeg"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "61fd7208-df41-4f19-a225-3b3b1ef11382"
      }
    }
  }
}
