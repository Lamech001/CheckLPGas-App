{
  "expo": {
    "name": "GasAround",
    "slug": "GasAround",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/android-icon-foreground.png",
    "scheme": "gasaround",                        
    "userInterfaceStyle": "automatic",
    "ios": {
      "statusBarStyle": "dark",
      "supportsTablet": true,
      "infoPlist": {
        "NSCallKitUsageDescription": "This app needs access to make phone calls to suppliers.",
        "NSLocationWhenInUseUsageDescription": "This app uses your location (when enabled) to show nearby gas suppliers."
      }
    },
    "android": {
      "statusBar": {
        "barStyle": "dark-content",
        "backgroundColor": "#FFFFFF"
      },
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#1A2A53",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCxJS7O0KTa8EPKImLjoJ1cLfozf2MvjKQ"
        }
      },
      "permissions": [
        "android.permission.CALL_PHONE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.lamech_kosgei.GasAround",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "gasaround"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 400,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#1A2A53",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "61fd7208-df41-4f19-a225-3b3b1ef11382"
      }
    }
  }
}
