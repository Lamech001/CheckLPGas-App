rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isConversationParticipant(conversationId) {
      // Field-safe participant check to avoid total denial if legacy docs miss fields.
      return isSignedIn() && exists(/databases/$(database)/documents/conversations/$(conversationId)) && (
        (get(/databases/$(database)/documents/conversations/$(conversationId)).data.consumerId is string &&
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.consumerId == request.auth.uid) ||
        (get(/databases/$(database)/documents/conversations/$(conversationId)).data.supplierId is string &&
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.supplierId == request.auth.uid)
      );
    }

    match /users/{userId} {


      allow read: if isSignedIn();
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && request.resource.data.uid == userId;
      allow delete: if isOwner(userId);
    }

    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(supplierId);
      allow delete: if isOwner(supplierId);
    }

    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (
        (resource.data.consumerId is string && resource.data.consumerId == request.auth.uid) ||
        (resource.data.supplierId is string && resource.data.supplierId == request.auth.uid)
      );

      allow create: if isSignedIn() && request.resource.data.consumerId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.consumerId == request.auth.uid ||
        resource.data.supplierId == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.consumerId == request.auth.uid ||
        resource.data.supplierId == request.auth.uid
      );
    }

    match /messages/{messageId} {
      allow read: if isConversationParticipant(resource.data.conversationId);
      allow create: if isSignedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        isConversationParticipant(request.resource.data.conversationId);
      allow update: if isSignedIn() &&
        resource.data.senderId == request.auth.uid &&
        request.resource.data.senderId == resource.data.senderId &&
        isConversationParticipant(resource.data.conversationId);
      allow delete: if isSignedIn() &&
        resource.data.senderId == request.auth.uid &&
        isConversationParticipant(resource.data.conversationId);
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId is string;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}

